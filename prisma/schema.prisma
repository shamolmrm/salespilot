generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Phase 4 Enums ────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CampaignType {
  EMAIL
  WHATSAPP
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  OPENED
  CLICKED
  UNSUBSCRIBED
}

enum ChatRoomType {
  DIRECT
  GROUP
}

enum ChatContentType {
  TEXT
  VOICE
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_CHANGE
  EXPORT
  BACKUP
  RESTORE
  VIEW_SENSITIVE
}

// ─── Phase 3 Enums ────────────────────────────────────────────────────────────

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  SALES_REP
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EMAIL
  SOCIAL_MEDIA
  EVENT
  OTHER
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailBodyType {
  TEXT
  HTML
}

enum EventType {
  MEETING
  TASK
  REMINDER
  CALL
  DEMO
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ─── Phase 1 models ───────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(SALES_REP)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leads          Lead[]
  customers      Customer[]
  deals          Deal[]
  refreshTokens  RefreshToken[]
  conversations  Conversation[]
  emailAccounts  EmailAccount[]
  calendarEvents CalendarEvent[]
  quotations     Quotation[]
  invoices       Invoice[]
  // Phase 4
  employee           Employee?
  activityLogs       ActivityLog[]
  tasksCreated       Task[]         @relation("TaskCreator")
  tasksAssigned      Task[]         @relation("TaskAssignee")
  taskComments       TaskComment[]
  taskListsCreated   TaskList[]
  documentsCreated   Document[]
  documentVersions   DocumentVersion[]
  chatMemberships    ChatRoomMember[]
  chatMessages       ChatMessage[]
  campaignsCreated   Campaign[]
  apiKeys            ApiKeyRecord[]
  managedDepartments Department[]   @relation("DepartmentManager")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  leads     Lead[]
}

model Lead {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  status       LeadStatus @default(NEW)
  source       LeadSource @default(OTHER)
  notes        String?
  companyId    String?
  assignedToId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company    Company? @relation(fields: [companyId], references: [id])
  assignedTo User?    @relation(fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model Customer {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  notes        String?
  companyId    String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company?    @relation(fields: [companyId], references: [id])
  assignedTo User?       @relation(fields: [assignedToId], references: [id])
  deals      Deal[]
  quotations Quotation[]
  invoices   Invoice[]

  @@index([assignedToId])
}

model Deal {
  id                String       @id @default(cuid())
  title             String
  value             Decimal      @default(0) @db.Decimal(15, 2)
  stage             DealStage    @default(PROSPECTING)
  priority          DealPriority @default(MEDIUM)
  expectedCloseDate DateTime?
  notes             String?
  customerId        String?
  assignedToId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer   Customer?   @relation(fields: [customerId], references: [id])
  assignedTo User?       @relation(fields: [assignedToId], references: [id])
  quotations Quotation[]

  @@index([stage])
  @@index([assignedToId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── Phase 2: AI Assistant ────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@index([createdAt])
}

model AiMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  promptTokens   Int?
  completionTokens Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ─── Phase 2: Email ───────────────────────────────────────────────────────────

model EmailAccount {
  id         String   @id @default(cuid())
  userId     String
  name       String
  fromEmail  String
  smtpHost   String
  smtpPort   Int      @default(587)
  smtpSecure Boolean  @default(false)
  smtpUser   String
  imapHost   String?
  imapPort   Int?
  imapSecure Boolean  @default(false)
  imapUser   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails EmailMessage[]

  @@index([userId])
}

model EmailMessage {
  id          String         @id @default(cuid())
  accountId   String
  messageId   String?        @unique
  direction   EmailDirection
  fromEmail   String
  fromName    String?
  toEmail     String
  subject     String
  body        String
  bodyType    EmailBodyType  @default(TEXT)
  isRead      Boolean        @default(false)
  sentAt      DateTime?
  receivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([direction])
  @@index([isRead])
  @@index([receivedAt])
}

// ─── Phase 2: Calendar ────────────────────────────────────────────────────────

model CalendarEvent {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  type        EventType   @default(MEETING)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean     @default(false)
  location    String?
  attendees   String?
  reminderAt  DateTime?
  status      EventStatus @default(SCHEDULED)
  relatedId   String?
  relatedType String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startAt])
  @@index([status])
}

// ─── Phase 3: Products ────────────────────────────────────────────────────────

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String?  @unique
  price       Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("USD")
  stockCount  Int      @default(0)
  unit        String   @default("item")
  imageUrl    String?
  isActive    Boolean  @default(true)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]

  @@index([categoryId])
  @@index([isActive])
}

// ─── Phase 3: Quotations ──────────────────────────────────────────────────────

model Quotation {
  id           String          @id @default(cuid())
  number       String          @unique
  status       QuotationStatus @default(DRAFT)
  dealId       String?
  customerId   String?
  userId       String
  currency     String          @default("USD")
  exchangeRate Decimal         @default(1) @db.Decimal(15, 6)
  subtotal     Decimal         @default(0) @db.Decimal(15, 2)
  discount     Decimal         @default(0) @db.Decimal(15, 2)
  discountType DiscountType    @default(FIXED)
  taxRate      Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal         @default(0) @db.Decimal(15, 2)
  total        Decimal         @default(0) @db.Decimal(15, 2)
  notes        String?
  terms        String?
  validUntil   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  deal     Deal?     @relation(fields: [dealId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  items    QuotationItem[]
  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  total       Decimal @default(0) @db.Decimal(15, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
}

// ─── Phase 3: Invoices ────────────────────────────────────────────────────────

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  status       InvoiceStatus @default(DRAFT)
  quotationId  String?
  customerId   String?
  userId       String
  currency     String        @default("USD")
  exchangeRate Decimal       @default(1) @db.Decimal(15, 6)
  subtotal     Decimal       @default(0) @db.Decimal(15, 2)
  discount     Decimal       @default(0) @db.Decimal(15, 2)
  discountType DiscountType  @default(FIXED)
  taxRate      Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal       @default(0) @db.Decimal(15, 2)
  total        Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid   Decimal       @default(0) @db.Decimal(15, 2)
  amountDue    Decimal       @default(0) @db.Decimal(15, 2)
  notes        String?
  terms        String?
  dueDate      DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  quotation Quotation? @relation(fields: [quotationId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  total       Decimal @default(0) @db.Decimal(15, 2)
  sortOrder   Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// ─── Phase 3: Payments ────────────────────────────────────────────────────────

model Payment {
  id             String          @id @default(cuid())
  invoiceId      String
  amount         Decimal         @db.Decimal(15, 2)
  currency       String
  status         PaymentStatus   @default(PENDING)
  provider       PaymentProvider
  providerTxId   String?         @unique
  providerData   Json?
  last4          String?
  payerEmail     String?
  refundedAmount Decimal?        @db.Decimal(15, 2)
  refundedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([providerTxId])
  @@index([status])
}

// ─── Phase 4: Team Management ────────────────────────────────────────────────

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  managerId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  manager   User?      @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[]
}

model Employee {
  id           String    @id @default(cuid())
  userId       String    @unique
  departmentId String?
  title        String
  employeeId   String?   @unique
  startDate    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

// Append-only — no UPDATE or DELETE routes are ever created for this model
model ActivityLog {
  id         String    @id @default(cuid())
  userId     String
  action     LogAction
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// ─── Phase 4: Task Management ────────────────────────────────────────────────

model TaskList {
  id            String   @id @default(cuid())
  name          String
  color         String   @default("#2563eb")
  createdByUserId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User   @relation(fields: [createdByUserId], references: [id])
  tasks     Task[]
}

model TaskLabel {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6b7280")

  tasks TaskLabelOnTask[]
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  taskListId      String?
  assignedToId    String?
  createdByUserId String
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  taskList    TaskList?  @relation(fields: [taskListId], references: [id])
  assignedTo  User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy   User       @relation("TaskCreator", fields: [createdByUserId], references: [id])
  comments    TaskComment[]
  labels      TaskLabelOnTask[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdByUserId])
  @@index([dueDate])
}

model TaskLabelOnTask {
  taskId      String
  taskLabelId String

  task  Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label TaskLabel @relation(fields: [taskLabelId], references: [id], onDelete: Cascade)

  @@id([taskId, taskLabelId])
}

model TaskComment {
  id      String   @id @default(cuid())
  taskId  String
  userId  String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── Phase 4: Documents ──────────────────────────────────────────────────────

model DocumentFolder {
  id              String   @id @default(cuid())
  name            String
  parentFolderId  String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parentFolderId], references: [id])
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@index([parentFolderId])
}

model Document {
  id               String   @id @default(cuid())
  name             String
  folderId         String?
  fileSize         Int
  mimeType         String
  storagePath      String
  currentVersionId String?  @unique
  ocrText          String?
  aiSummary        String?
  createdByUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  folder         DocumentFolder?   @relation(fields: [folderId], references: [id])
  createdBy      User              @relation(fields: [createdByUserId], references: [id])
  versions       DocumentVersion[]

  @@index([folderId])
  @@index([createdByUserId])
}

model DocumentVersion {
  id              String   @id @default(cuid())
  documentId      String
  versionNumber   Int
  storagePath     String
  fileSize        Int
  changeNote      String?
  createdByUserId String
  createdAt       DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdByUserId], references: [id])

  @@index([documentId])
}

// ─── Phase 4: Marketing ──────────────────────────────────────────────────────

model Campaign {
  id              String         @id @default(cuid())
  name            String
  type            CampaignType   @default(EMAIL)
  status          CampaignStatus @default(DRAFT)
  subject         String?
  body            String?
  targetCount     Int            @default(0)
  sentCount       Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy  User                @relation(fields: [createdByUserId], references: [id])
  recipients CampaignRecipient[]

  @@index([status])
  @@index([createdByUserId])
}

model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  email      String
  name       String?
  status     CampaignRecipientStatus @default(PENDING)
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime                @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
}

// ─── Phase 4: Chat ────────────────────────────────────────────────────────────

model ChatRoom {
  id              String       @id @default(cuid())
  name            String?
  type            ChatRoomType @default(GROUP)
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members  ChatRoomMember[]
  messages ChatMessage[]

  @@index([type])
}

model ChatRoomMember {
  chatRoomId String
  userId     String
  joinedAt   DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatRoomId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String          @id @default(cuid())
  chatRoomId     String
  userId         String
  content        String
  contentType    ChatContentType @default(TEXT)
  attachmentPath String?
  isEdited       Boolean         @default(false)
  editedAt       DateTime?
  createdAt      DateTime        @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatRoomId])
  @@index([createdAt])
}

// ─── Phase 4: Settings ───────────────────────────────────────────────────────

model CompanySettings {
  id        String   @id @default(cuid())
  name      String   @default("My Company")
  logoPath  String?
  email     String   @default("")
  phone     String?
  address   String?
  timezone  String   @default("UTC")
  language  String   @default("en")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKeyRecord {
  id              String    @id @default(cuid())
  name            String
  service         String
  encryptedKey    String
  maskedKey       String
  createdByUserId String
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
}
