# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salespilot"

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-64-byte-random-hex-string"

# JWT refresh token expiry in days
REFRESH_TOKEN_EXPIRY_DAYS=7

# App port (Next.js server)
PORT=3000

# Node environment
NODE_ENV=development

# Optional: license key (leave blank in dev)
LICENSE_KEY=

# ── Phase 2: AI Assistant ────────────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
# NEVER commit your real key to git
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AI rate limit per user (20 requests per 10 minutes by default)
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=600000
